# ctrl.rodeo AI Agent System Configuration
# Copy this file to .env.local and fill in your values
# NEVER commit .env.local to the repository

# ===========================================
# NOTION INTEGRATION
# ===========================================

# Get from: https://www.notion.so/my-integrations
NOTION_API_KEY=secret_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Your Notion workspace ID (from any Notion URL)
NOTION_WORKSPACE_ID=

# Page IDs for each section (get from page URLs)
NOTION_PAGE_STRATEGIC=
NOTION_PAGE_DEVELOPMENT=
NOTION_PAGE_OPERATIONS=
NOTION_PAGE_CROSS_FUNCTIONAL=

# ===========================================
# AI PROVIDERS
# ===========================================

# Get from: https://console.anthropic.com/
ANTHROPIC_API_KEY=sk-ant-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Get from: https://platform.openai.com/ (optional, for fallback)
OPENAI_API_KEY=sk-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# ===========================================
# SUPABASE (already configured for this project)
# ===========================================

# Get from: Supabase Dashboard → Settings → API
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=eyxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
SUPABASE_SERVICE_KEY=eyxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# ===========================================
# GITHUB (for API access)
# ===========================================

# Get from: GitHub → Settings → Developer settings → Personal access tokens
GITHUB_TOKEN=ghp_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
GITHUB_REPO=fikei/fikei.github.io

# ===========================================
# AGENT CONFIGURATION
# ===========================================

# Primary AI model for agents
AI_MODEL_PRIMARY=claude-3-haiku-20240307

# Fallback AI model
AI_MODEL_FALLBACK=gpt-4o-mini

# Agent execution mode: 'sync' or 'async'
AGENT_EXECUTION_MODE=async

# Enable debug logging for agents
AGENT_DEBUG=false

# ===========================================
# SYNC CONFIGURATION
# ===========================================

# How often to sync with Notion (in minutes)
NOTION_SYNC_INTERVAL=15

# Enable automatic sync on file changes
AUTO_SYNC_ENABLED=true

# Sync direction: 'bidirectional', 'notion-to-github', 'github-to-notion'
SYNC_DIRECTION=bidirectional
