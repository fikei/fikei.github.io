{
  "name": "Boards — ctrl.rodeo",
  "short_name": "Boards",
  "description": "Save, organize, and curate your links",
  "start_url": "/boards/",
  "scope": "/",
  "icons": [
    {
      "src": "/images/icons/favicons/android-chrome-192x192.png",
      "sizes": "192x192",
      "type": "image/png"
    },
    {
      "src": "/images/icons/favicons/android-chrome-512x512.png",
      "sizes": "512x512",
      "type": "image/png"
    }
  ],
  "theme_color": "#000000",
  "background_color": "#000000",
  "display": "standalone",
  "share_target": {
    "action": "/boards/pwa-share.html",
    "method": "GET",
    "enctype": "application/x-www-form-urlencoded",
    "params": {
      "title": "title",
      "text": "text",
      "url": "url"
    }
  }
}