        { "name": "long-pros", "optionA": { "title": "A", "pros": ["Pro 1", "Pro 2", "Pro 3", "Pro 4", "Pro 5"], "cons": ["Con 1"] }, "optionB": { "title": "B", "pros": ["Pro 1"], "cons": ["Con 1", "Con 2", "Con 3", "Con 4", "Con 5"] }, "dividerLabel": "OR" }
      ]
